{
  "machineOutput.result": {
    "$defs": {
      "machineOutput.result": {
        "additionalProperties": false,
        "description": "Validated machine-output payload.",
        "properties": {
          "kind": {
            "enum": [
              "task",
              "workflow"
            ],
            "type": "string"
          },
          "metadata": {
            "additionalProperties": {
              "type": "string"
            },
            "propertyNames": {
              "pattern": "^[a-z][a-z0-9_]*$",
              "type": "string"
            },
            "type": "object"
          },
          "ok": {
            "type": "boolean"
          },
          "output_path": {
            "minLength": 1,
            "pattern": "^/.*$",
            "type": "string"
          }
        },
        "required": [
          "kind",
          "ok"
        ],
        "type": "object"
      },
      "runtime.event": {
        "oneOf": [
          {
            "additionalProperties": false,
            "properties": {
              "exit_code": {
                "maximum": 255,
                "minimum": 0,
                "type": "integer"
              },
              "kind": {
                "const": "passed"
              },
              "message": {
                "oneOf": [
                  {
                    "minLength": 1,
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "exit_code",
              "kind"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "kind": {
                "const": "queued"
              },
              "run_id": {
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "kind",
              "run_id"
            ],
            "type": "object"
          }
        ]
      },
      "runtime.summary": {
        "additionalProperties": false,
        "description": "Workflow summary envelope.",
        "properties": {
          "kind": {
            "const": "workflow-summary"
          },
          "payload": {
            "$ref": "#/$defs/runtime.summary.payload"
          },
          "version": {
            "const": 1
          }
        },
        "required": [
          "kind",
          "payload",
          "version"
        ],
        "type": "object"
      },
      "runtime.summary.payload": {
        "additionalProperties": false,
        "properties": {
          "attempt_id": {
            "minLength": 1,
            "type": "string"
          },
          "duration_ms": {
            "oneOf": [
              {
                "minimum": 0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "exit_code": {
            "maximum": 255,
            "minimum": 0,
            "type": "integer"
          },
          "labels": {
            "additionalProperties": {
              "type": "string"
            },
            "propertyNames": {
              "pattern": "^[a-z][a-z0-9_]*$",
              "type": "string"
            },
            "type": "object"
          },
          "run_id": {
            "minLength": 1,
            "type": "string"
          },
          "unit_ids": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "minItems": 1,
            "type": "array"
          },
          "workflow_id": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "attempt_id",
          "exit_code",
          "run_id",
          "unit_ids",
          "workflow_id"
        ],
        "type": "object"
      }
    },
    "$id": "nixfied:contract:machineOutput.result:v1",
    "$ref": "#/$defs/machineOutput.result",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "Validated machine-output payload.",
    "title": "machineOutput.result"
  },
