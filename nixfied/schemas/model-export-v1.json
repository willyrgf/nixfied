{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nixfied.dev/schemas/model-export-v1.json",
  "title": "Nixfied Model Export v1",
  "type": "object",
  "required": [
    "schema",
    "identity",
    "runtime",
    "services",
    "tasks",
    "workflows",
    "views",
    "state"
  ],
  "properties": {
    "schema": {
      "type": "object",
      "required": [ "kind", "version" ],
      "properties": {
        "kind": { "const": "nixfied-model" },
        "version": { "const": 2 }
      }
    },
    "identity": { "type": "object" },
    "runtime": { "type": "object" },
    "services": { "type": "object" },
    "tasks": { "type": "object" },
    "workflows": { "type": "object" },
    "views": { "type": "object" },
    "state": { "type": "object" }
  },
  "additionalProperties": true
}
